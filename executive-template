<div class="executive">

  <header>

    <h1>{{name}}</h1>

    <h2>{{desired_position}}</h2>

    <div class="contact">

      {{email}}
      •
      {{phone}}
      •
      {{city}}

    </div>

  </header>

  <section>

    <h3>Perfil Profissional</h3>

    <p>
      {{objective}}
    </p>

  </section>

  <section>

    <h3>Experiência Profissional</h3>

    {{#experiences}}

    <div class="job">

      <div class="job-header">

        <strong>{{position}}</strong>

        <span>
          {{start_month}}/{{start_year}}
          -
          {{period_label}}
        </span>

      </div>

      <div>

        {{company}}

      </div>

      <p>
        {{description}}
      </p>

    </div>

    {{/experiences}}

  </section>

  <section>

    <h3>Competências-Chave</h3>

    <p>
      {{skills_text}}
    </p>

  </section>

  <section>

    <h3>Formação Acadêmica</h3>

    {{#education}}

    <div>

      <strong>{{course}}</strong>

      -
      {{institution}}

    </div>

    {{/education}}

  </section>

  <section>

    <h3>Certificações</h3>

    {{#certifications}}

    <div>

      {{title}}

      -
      {{issuer}}

    </div>

    {{/certifications}}

  </section>

</div>