<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Currículo - Francisco Ripardo</title>

    <style>
        /* =========================================================
           RESET
        ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #e9ecef;
            color: #222;
            line-height: 1.45;
        }


        /* =========================================================
           ÁREA DA TELA
        ========================================================= */

        .pagina {
            width: 210mm;
            min-height: 297mm;
            margin: 20px auto;
            background: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
        }


        /* =========================================================
           CURRÍCULO
        ========================================================= */

        #curriculo {
            width: 100%;
            min-height: 297mm;
            padding: 15mm;

            background: #fff;

            display: flex;
            flex-direction: column;
        }


        /* =========================================================
           CABEÇALHO
        ========================================================= */

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;

            padding-bottom: 8px;
            border-bottom: 2px solid #222;

            margin-bottom: 12px;
        }

        .nome {
            margin: 0;
            font-size: 27px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .cargo {
            margin: 3px 0 0;
            font-size: 15px;
            color: #555;
        }

        .contato {
            text-align: right;
            font-size: 10.5px;
            line-height: 1.5;
        }

        .contato a {
            color: inherit;
            text-decoration: none;
        }


        /* =========================================================
           SEÇÕES
        ========================================================= */

        .secao {
            margin-bottom: 10px;

            /* Evita que a seção seja dividida na impressão */
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .titulo-secao {
            margin: 0 0 5px;

            padding-bottom: 3px;

            font-size: 13px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.8px;

            border-bottom: 1px solid #bbb;
        }

        .texto {
            margin: 0;
            font-size: 10.5px;
            text-align: justify;
        }


        /* =========================================================
           EXPERIÊNCIA PROFISSIONAL
        ========================================================= */

        .experiencia {
            margin-bottom: 8px;

            break-inside: avoid;
            page-break-inside: avoid;
        }

        .experiencia:last-child {
            margin-bottom: 0;
        }

        .experiencia-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 10px;
        }

        .empresa {
            font-size: 11.5px;
            font-weight: 700;
        }

        .periodo {
            font-size: 10px;
            color: #555;
            white-space: nowrap;
        }

        .cargo-experiencia {
            margin: 1px 0 3px;

            font-size: 10.5px;
            font-weight: 600;
        }

        .experiencia ul {
            margin: 3px 0 0;
            padding-left: 17px;

            font-size: 10px;
        }

        .experiencia li {
            margin-bottom: 2px;
        }


        /* =========================================================
           FORMAÇÃO
        ========================================================= */

        .formacao-item {
            display: flex;
            justify-content: space-between;

            margin-bottom: 5px;

            break-inside: avoid;
            page-break-inside: avoid;
        }

        .formacao-item:last-child {
            margin-bottom: 0;
        }

        .curso {
            font-size: 10.5px;
            font-weight: 700;
        }

        .instituicao {
            font-size: 10px;
        }

        .ano {
            font-size: 10px;
            color: #555;
            white-space: nowrap;
        }


        /* =========================================================
           HABILIDADES
        ========================================================= */

        .habilidades {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .habilidade {
            padding: 3px 7px;

            font-size: 9px;

            border: 1px solid #aaa;
            border-radius: 3px;

            background: #f5f5f5;
        }


        /* =========================================================
           PROJETOS
        ========================================================= */

        .projeto {
            margin-bottom: 6px;

            break-inside: avoid;
            page-break-inside: avoid;
        }

        .projeto:last-child {
            margin-bottom: 0;
        }

        .projeto-titulo {
            margin: 0;

            font-size: 10.5px;
            font-weight: 700;
        }

        .projeto-descricao {
            margin: 1px 0 0;

            font-size: 10px;
        }


        /* =========================================================
           RODAPÉ
        ========================================================= */

        .rodape {
            margin-top: auto;
            padding-top: 7px;

            border-top: 1px solid #ccc;

            font-size: 8.5px;
            color: #777;

            text-align: center;
        }


        /* =========================================================
           BOTÕES / ELEMENTOS SOMENTE DA TELA
        ========================================================= */

        .acoes {
            width: 210mm;
            margin: 15px auto 0;

            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn {
            border: 0;
            padding: 8px 14px;

            background: #222;
            color: #fff;

            border-radius: 4px;

            cursor: pointer;
            font-size: 13px;
        }

        .btn:hover {
            background: #444;
        }


        /* =========================================================
           IMPRESSÃO
        ========================================================= */

        @page {
            size: A4;
            margin: 0;
        }

        @media print {

            /*
             * Remove o fundo da página e qualquer espaçamento
             * criado pelo navegador.
             */
            html,
            body {
                width: 210mm;
                height: 297mm;

                margin: 0;
                padding: 0;

                background: #fff;
            }

            /*
             * Tudo que não for o currículo desaparece.
             */
            body * {
                visibility: hidden;
            }

            /*
             * Apenas o currículo e seus filhos ficam visíveis.
             */
            #curriculo,
            #curriculo * {
                visibility: visible;
            }

            /*
             * Posiciona o currículo exatamente no canto
             * superior esquerdo da folha.
             */
            #curriculo {
                position: absolute;
                left: 0;
                top: 0;

                width: 210mm;
                min-height: 297mm;
                height: 297mm;

                margin: 0;

                padding: 15mm;

                box-shadow: none;
            }

            /*
             * Esconde elementos auxiliares da impressão.
             */
            .acoes {
                display: none !important;
            }

            /*
             * Evita que determinados elementos sejam
             * quebrados entre páginas.
             */
            .secao,
            .experiencia,
            .formacao-item,
            .projeto {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            /*
             * Mantém as cores e fundos durante a impressão.
             */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }


        /* =========================================================
           RESPONSIVIDADE DA VISUALIZAÇÃO
        ========================================================= */

        @media screen and (max-width: 850px) {

            .pagina {
                width: calc(100% - 20px);
                min-height: auto;
                margin: 10px;
            }

            #curriculo {
                min-height: auto;
            }

            .acoes {
                width: calc(100% - 20px);
                margin: 10px;
            }
        }
    </style>
</head>

<body>

