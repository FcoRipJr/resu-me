<div class="resume">

  <header>
    <h1>{{name}}</h1>
    <p>{{desired_position}}</p>
    <p>
      {{email}} |
      {{phone}} |
      {{city}}
    </p>
  </header>

  <section>
    <h2>Resumo Profissional</h2>
    <p>{{objective}}</p>
  </section>

  <section>
    <h2>Competências</h2>
    <ul>
      {{#skills}}
      <li>{{.}}</li>
      {{/skills}}
    </ul>
  </section>

  <section>
    <h2>Experiência Profissional</h2>

    {{#experiences}}
    <article>

      <h3>{{position}}</h3>

      <strong>{{company}}</strong>

      <p>
        {{start_month}}/{{start_year}}
        -
        {{period_label}}
      </p>

      <p>{{description}}</p>

      <p>
        Tecnologias:
        {{skills_text}}
      </p>

    </article>
    {{/experiences}}

  </section>

  <section>
    <h2>Formação</h2>

    {{#education}}
    <p>
      <strong>{{course}}</strong><br>
      {{institution}}
    </p>
    {{/education}}

  </section>

</div>